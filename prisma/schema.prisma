generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum AppointmentStatus {
  CONFIRMED
  IN_PROGRESS
  CANCELLED
  COMPLETED
  NEEDS_RESCHEDULE
  NO_SHOW
}

enum EmailType {
  BOOKING_CONFIRMATION
  REMINDER
  CANCELLATION
  LEAVE_NOTICE
  MEDICATION_REMINDER
  RESCHEDULE_NOTICE
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  DEAD
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  role         Role           @default(PATIENT)
  phone        String?
  createdAt    DateTime       @default(now())

  // Relations
  doctorProfile          DoctorProfile?
  appointmentsAsPatient  Appointment[]   @relation("PatientAppointments")
  calendarEvents         CalendarEvent[]
  googleCalendarAuth     GoogleCalendarAuth?

  @@map("users")
}

model GoogleCalendarAuth {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken    String?   @db.Text
  refreshToken   String    @db.Text
  expiryDate     BigInt?
  needsReauth    Boolean   @default(false)
  connectedEmail String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("google_calendar_auth")
}

model DoctorProfile {
  id                  String         @id @default(cuid())
  userId              String         @unique
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization      String
  bio                 String?        @db.Text
  slotDurationMinutes Int            @default(30)
  workingHours        Json           // e.g. { "monday": { "start": "09:00", "end": "17:00" }, ... }
  isActive            Boolean        @default(true)

  // Relations
  leaves              DoctorLeave[]
  appointments        Appointment[]

  @@map("doctor_profiles")
}

model DoctorLeave {
  id        String        @id @default(cuid())
  doctorId  String
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date      DateTime      @db.Date
  reason    String?       @db.Text
  createdAt DateTime      @default(now())

  @@map("doctor_leaves")
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
}

model Appointment {
  id                    String            @id @default(cuid())
  doctorId              String
  doctor                DoctorProfile     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patientId             String
  patient               User              @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  startTime             DateTime          @db.Timestamptz(6)
  endTime               DateTime          @db.Timestamptz(6)
  status                AppointmentStatus @default(CONFIRMED)
  symptomText           String            @db.Text
  symptomImage          String?           @db.Text
  checkedInAt           DateTime?         @db.Timestamptz(6)
  preVisitSummaryStatus String?           @default("PENDING")
  preVisitSummaryJson   Json?
  postVisitNotes        String?           @db.Text
  postVisitSummaryStatus String?          @default("PENDING")
  postVisitSummaryJson  Json?
  prescriptionJson      Json?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  // Relations
  emailLogs            EmailLog[]
  calendarEvents       CalendarEvent[]
  medicationReminders  MedicationReminder[]

  @@index([doctorId, startTime])
  @@index([doctorId, checkedInAt])
  @@index([patientId, startTime])
  @@map("appointments")
}

model MedicationReminder {
  id            String         @id @default(cuid())
  appointmentId String
  appointment   Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  medicineName  String
  dosage        String?
  instructions  String?
  scheduledFor  DateTime       @db.Timestamptz(6)
  status        ReminderStatus @default(PENDING)
  sentAt        DateTime?
  lastError     String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([scheduledFor, status])
  @@index([appointmentId])
  @@map("medication_reminders")
}

model EmailLog {
  id            String       @id @default(cuid())
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  toEmail       String
  type          EmailType
  status        EmailStatus  @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?      @db.Text
  createdAt     DateTime     @default(now())

  @@map("email_logs")
}

model CalendarEvent {
  id            String       @id @default(cuid())
  appointmentId String
  appointment   Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleEventId String
  status        String       @default("SYNCED")
  lastError     String?      @db.Text
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([appointmentId, userId])
  @@index([appointmentId])
  @@index([userId])
  @@map("calendar_events")
}
