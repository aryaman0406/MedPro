# PostgreSQL Database URL (Neon / Supabase / Local PostgreSQL)
# Example Supabase direct or pooled connection:
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true"

# Auth.js / NextAuth Secret
# Generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET="your-32-character-random-auth-secret-key-here"

# NextAuth URL
NEXTAUTH_URL="http://localhost:3000"

# Google Gemini API Key (Pre-visit intake analysis & clinical summaries)
# A free Google AI Studio key with no billing is sufficient (https://aistudio.google.com/)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"

# Upstash Redis (5-Minute Slot Hold Locking)
# Retrieve from https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL="https://your-redis-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token"

# Upstash QStash (Medication Reminder & Email Queue Background Jobs)
# Retrieve from https://console.upstash.com/qstash
QSTASH_CURRENT_SIGNING_KEY="your-qstash-current-signing-key"
QSTASH_NEXT_SIGNING_KEY="your-qstash-next-signing-key"
CRON_SECRET="your-optional-cron-secret-for-manual-calls"

# Brevo SMTP Relay (Email Delivery Engine - 300 free emails/day)
# Retrieve from https://app.brevo.com/settings/keys/smtp
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_USER="your-brevo-account-email@example.com"
BREVO_SMTP_KEY="your-brevo-smtp-key-here"
EMAIL_FROM="MedTrack Pro <no-reply@medtrack.pro>"

# Google Calendar OAuth 2.0 (Patient & Doctor Calendar Sync)
# Retrieve from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:3000/api/auth/google-calendar/callback"

# Pusher Channels (Real-Time Clinical Queue & Patient Position Sync)
# Retrieve from https://dashboard.pusher.com/ (Free Sandbox: 200k msgs/day)
PUSHER_APP_ID="your-pusher-app-id"
PUSHER_KEY="your-pusher-key"
PUSHER_SECRET="your-pusher-secret"
PUSHER_CLUSTER="mt1"
NEXT_PUBLIC_PUSHER_KEY="your-pusher-key"
NEXT_PUBLIC_PUSHER_CLUSTER="mt1"
